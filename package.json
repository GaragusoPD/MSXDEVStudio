{
  "name": "msxdevstudio",
  "version": "0.1.0",
  "description": "A desktop IDE for MSX game development.",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Pablo Garaguso <pablo.garaguso@gmail.com>",
  "homepage": "https://github.com/GaragusoPD/MSXStudio",
  "desktopName": "com.msxdevstudio.app.desktop",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "build:dist": "npm run build && electron-builder",
    "build:dist:linux": "npm run build && electron-builder --linux",
    "build:dist:win": "npm run build && electron-builder --win",
    "build:dist:dir": "npm run build && electron-builder --dir",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "monaco:shim": "node scripts/generate-monaco-shim.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material-symbols/font-400": "^0.45.10",
    "@types/node": "^24.13.3",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "marked": "^18.0.9",
    "monaco-editor": "^0.56.0",
    "pinia": "^3.0.4",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "yauzl": "^3.4.0"
  }
}
